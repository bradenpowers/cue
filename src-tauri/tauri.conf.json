{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cue",
  "version": "0.1.0",
  "identifier": "local.butler.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Cue", "width": 1120, "height": 780, "minWidth": 860, "minHeight": 650, "theme": "Dark" },
      { "label": "floating", "url": "floating.html", "title": "Cue · Live assistant", "width": 390, "height": 440, "alwaysOnTop": true, "visibleOnAllWorkspaces": true, "skipTaskbar": true, "visible": false, "theme": "Dark" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
